<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.onerlaydaemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/local/libexec/onerlaydaemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Downloads/onerlay_daemon_err.log</string>
    <key>StandardOutPath</key>
    <string>/var/mobile/Downloads/onerlay_daemon_out.log</string>
</dict>
</plist>
